% ===================================================================
% 包名: fix_linespacing
% ===================================================================
% 功能: 修复LaTeX文档行距问题
% 说明: 修正段落间距和基线间距计算，解决中文文档行距不一致问题
% ===================================================================

% -----------------------------------------------------------------------------
% 第一部分: 基础设置与依赖
% -----------------------------------------------------------------------------

% 声明LaTeX版本和包信息
\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{fix_linespacing}[2024/03/27 fix_linespacing Package]

% 依赖包说明:
%   setspace:   行距控制包
%   calc:       长度计算支持
\RequirePackage{setspace}
\RequirePackage{calc}

% -----------------------------------------------------------------------------
% 第二部分: 间距变量定义
% -----------------------------------------------------------------------------

% 长度变量说明:
%   \modparskip:       修正后的段落间距
%   \modbaselineskip:  修正后的基线间距
\newlength\modparskip
\newlength\modbaselineskip

% 基线拉伸因子（默认值1.0）
\def\baselinestretch{1}

% -----------------------------------------------------------------------------
% 第三部分: 间距计算
% -----------------------------------------------------------------------------

% 计算修正后的间距值
% 公式: 原间距 / 基线拉伸因子
\setlength\modparskip{\parskip/\real{\baselinestretch}}
\setlength\modbaselineskip{\baselineskip/\real{\baselinestretch}}

% -----------------------------------------------------------------------------
% 第四部分: 环境重定义
% -----------------------------------------------------------------------------

% 重定义spacing环境
% 功能: 修正间距计算，确保中文文档行距一致
% 参数:
%   #1: 行距倍数
\makeatletter
\renewenvironment{spacing}[1]{\par
\def\baselinestretch{#1}
\ifx\@currsize\normalsize\@normalsize\else\@currsize\fi
}
{\par
\vskip \modparskip
\vskip \modbaselineskip
}
\makeatother

\endinput
