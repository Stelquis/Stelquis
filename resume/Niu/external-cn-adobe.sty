% ===================================================================
% 包名: external-cn-adobe
% ===================================================================
% 功能: 中文字体配置（Adobe字体，外部模式）
% 说明: 字体从 assets/cn-fonts/ 目录加载，支持宋体、黑体、楷体、仿宋
% ===================================================================

% -----------------------------------------------------------------------------
% 第一部分: 基础设置与依赖
% -----------------------------------------------------------------------------

% 声明LaTeX版本和包信息
\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{external-cn-adobe}[2024/03/27 external-cn-adobe Package]

% 依赖包说明:
%   fontspec:   字体选择系统，支持OpenType字体
%   xeCJK:      中日韩文字处理，自动排版优化
\RequirePackage{fontspec}
\RequirePackage{xeCJK}

% -----------------------------------------------------------------------------
% 第二部分: 字体路径配置
% -----------------------------------------------------------------------------

% 设置字体搜索路径和文本映射
%   Path:           字体文件所在目录
%   Mapping:        文本映射方式
\defaultfontfeatures{Path = ../assets/cn-fonts/, Mapping=tex-text}

% -----------------------------------------------------------------------------
% 第三部分: CJK主字体设置
% -----------------------------------------------------------------------------

% 主字体: Adobe宋体（宋体）
% 字体说明:
%   正文字体:   adobe-song-ti-light.otf     宋体（细体）
%   粗体:       adobe-hei-ti-regular.otf    黑体
%   斜体:       adobe-kai-ti-regular.otf    楷体
%   小型大写:   adobe-hei-ti-regular.otf    黑体
\setCJKmainfont[
BoldFont=adobe-hei-ti-regular.otf,
ItalicFont=adobe-kai-ti-regular.otf,
SmallCapsFont=adobe-hei-ti-regular.otf
]{adobe-song-ti-light.otf}

% 无衬线字体: Adobe黑体（黑体）
\setCJKsansfont{adobe-hei-ti-regular.otf}

% 等宽字体: Adobe仿宋（仿宋）
\setCJKmonofont{adobe-fang-song-regular.otf}

% -----------------------------------------------------------------------------
% 第四部分: CJK字体族定义
% -----------------------------------------------------------------------------

% 字体族说明:
%   zhsong:     宋体族，用于正文
%   zhhei:      黑体族，用于标题和强调
%   zhfs:       仿宋族，用于等宽文本
%   zhkai:      楷体族，用于斜体效果
\setCJKfamilyfont{zhsong}{adobe-song-ti-light.otf}
\setCJKfamilyfont{zhhei}{adobe-hei-ti-regular.otf}
\setCJKfamilyfont{zhfs}{adobe-fang-song-regular.otf}
\setCJKfamilyfont{zhkai}{adobe-kai-ti-regular.otf}

% -----------------------------------------------------------------------------
% 第五部分: 字体快捷命令
% -----------------------------------------------------------------------------

% 快捷命令说明:
%   \songti:    切换到宋体
%   \heiti:     切换到黑体
%   \kaishu:    切换到楷体
%   \fangsong:  切换到仿宋
\newcommand*{\songti}{\CJKfamily{zhsong}}
\newcommand*{\heiti}{\CJKfamily{zhhei}}
\newcommand*{\kaishu}{\CJKfamily{zhkai}}
\newcommand*{\fangsong}{\CJKfamily{zhfs}}

\endinput
