% ===================================================================
% 包名: external-en-texgyre
% ===================================================================
% 功能: 英文字体配置（TeX Gyre Termes字体，外部模式）
% 说明: 字体从 assets/en-fonts/ 目录加载，Times New Roman风格
% ===================================================================

% -----------------------------------------------------------------------------
% 第一部分: 基础设置与依赖
% -----------------------------------------------------------------------------

% 声明LaTeX版本和包信息
\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{external-en-texgyre}[2024/03/27 external-en-texgyre Package]

% 依赖包说明:
%   fontspec:   字体选择系统，支持OpenType字体
\RequirePackage{fontspec}

% -----------------------------------------------------------------------------
% 第二部分: 字体路径配置
% -----------------------------------------------------------------------------

% 设置字体搜索路径和文本映射
%   Path:           字体文件所在目录
%   Mapping:        文本映射方式
\defaultfontfeatures{Path = assets/en-fonts/, Mapping=tex-text}

% -----------------------------------------------------------------------------
% 第三部分: 正文字体设置
% -----------------------------------------------------------------------------

% 主字体: TeX Gyre Termes（Times New Roman风格）
% 字体说明:
%   正文字体:   tex-gyre-termes-regular.otf       常规体
%   粗体:       tex-gyre-termes-bold.otf          粗体
%   斜体:       tex-gyre-termes-italic.otf        斜体
%   粗斜体:     tex-gyre-termes-bold-italic.otf   粗斜体
\setmainfont[
BoldFont=tex-gyre-termes-bold.otf,
ItalicFont=tex-gyre-termes-italic.otf,
BoldItalicFont=tex-gyre-termes-bold-italic.otf
]{tex-gyre-termes-regular.otf}

% 无衬线字体: TeX Gyre Termes Bold
\setsansfont{tex-gyre-termes-bold.otf}

% 等宽字体: TeX Gyre Termes Regular
\setmonofont{tex-gyre-termes-regular.otf}

% -----------------------------------------------------------------------------
% 第四部分: 特殊字体定义
% -----------------------------------------------------------------------------

% 小型大写字体: Fontin Small Caps
% 说明: 用于小型大写文本效果
\newfontfamily\smallcaps{fontin-small-caps.otf}

\endinput
